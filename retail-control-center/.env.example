# ───────────────────────── Data source ─────────────────────────
# "sheets" = Google Sheets (Single Source of Truth), "local" = local JSON demo file.
# If unset: sheets when GOOGLE_SHEETS_ID is set, otherwise local.
DATA_SOURCE=local

# Google Sheets — spreadsheet ID is the long id in the sheet URL: /spreadsheets/d/<ID>/edit
GOOGLE_SHEETS_ID=

# Service account credentials (server-side only — never exposed to the browser).
# Option A: email + private key (keep the \n escapes, wrap in double quotes)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Option B: the whole JSON key file, raw or base64-encoded (takes precedence over A)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Server-side read cache for Google Sheets (ms). Protects the Sheets API quota.
SHEETS_CACHE_TTL_MS=8000

# ───────────────────────── Local demo mode ─────────────────────────
# Where the local JSON store lives (created and seeded automatically on first run).
LOCAL_DATA_FILE=.data/db.json

# ───────────────────────── App ─────────────────────────
# Name written in Last_Updated_By / Updated_By when the browser does not send one.
DEFAULT_USER_NAME=PMO Admin

# Optional HTTP Basic protection (recommended if the URL is reachable outside the company network).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Allow "Reset demo data" to overwrite the Google Sheet (dangerous — leave false in production).
ALLOW_SHEETS_RESET=false
